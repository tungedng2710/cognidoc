# Copy to .env for local Docker Compose development. Never commit real credentials.
POSTGRES_DB=data_studio
POSTGRES_USER=data_studio
POSTGRES_PASSWORD=replace-with-a-local-password
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=replace-with-a-local-secret
AUTH_SECRET_KEY=replace-with-at-least-32-random-bytes
# RUSTFS_API_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# API_PORT=8001
# RUSTFS_DATA_PATH=/absolute/path/to/rustfs
# UPLOAD_STAGING_PATH=/absolute/path/to/uploads
# VERSIONING_DATA_PATH=/absolute/path/to/internal-git

# Optional direct-process overrides (all use the DATA_STUDIO_ prefix).
# DATA_STUDIO_DATABASE_URL=sqlite:///./data/data-studio.db
# DATA_STUDIO_STORAGE_BACKEND=local
# DATA_STUDIO_STORAGE_ROOT=./data/objects
# DATA_STUDIO_STAGING_ROOT=./data/uploads
# DATA_STUDIO_VERSIONING_ROOT=./data/repositories
# DATA_STUDIO_DVC_REMOTE_URL=/absolute/path/to/dvc-cache
# DATA_STUDIO_REDIS_URL=redis://localhost:6379/0
# DATA_STUDIO_AUTH_COOKIE_SECURE=false
# Set any resource cap to 0 only for a trusted private deployment to disable that cap.
# DATA_STUDIO_MAX_UPLOAD_BYTES=0
# DATA_STUDIO_MAX_FILE_BYTES=0
# DATA_STUDIO_MAX_FILE_COUNT=0
# VITE_API_URL=http://localhost:8000/api/v1
